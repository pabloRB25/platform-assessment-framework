{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alyp.studio/paf/schemas/encuadre.schema.json",
  "title": "PAF Encuadre — results/encuadre.json (Fase 0)",
  "type": "object",
  "required": ["profile", "targets", "access_inventory", "toolchain", "framework_version", "catalog_version"],
  "properties": {
    "profile": { "type": "string" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["repo", "branch", "sha"],
        "properties": {
          "repo": { "type": "string" },
          "branch": { "type": "string" },
          "sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "access_inventory": {
      "type": "object",
      "required": ["source_code", "git_history", "repo_api", "ci_history", "cloud"],
      "additionalProperties": false,
      "properties": {
        "source_code": { "$ref": "#/$defs/access" },
        "git_history": { "$ref": "#/$defs/access" },
        "repo_api": { "$ref": "#/$defs/access" },
        "ci_history": { "$ref": "#/$defs/access" },
        "cloud": { "$ref": "#/$defs/access" },
        "environments": { "$ref": "#/$defs/access" }
      }
    },
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool", "version"],
        "properties": {
          "tool": { "type": "string" },
          "version": { "type": "string" },
          "ruleset": { "type": "string", "description": "versión/commit del ruleset pinneado (semgrep, gitleaks config)" },
          "digest": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "framework_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "catalog_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "baseline": {
      "type": ["object", "null"],
      "properties": {
        "report_path": { "type": "string" },
        "comparable": { "type": "boolean" },
        "incomparability_reasons": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["report_path", "comparable"],
      "additionalProperties": false
    },
    "out_of_scope": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false,
  "$defs": {
    "access": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
